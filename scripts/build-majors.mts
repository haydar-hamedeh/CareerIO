// Builds src/lib/onboarding/majors-cip.ts from the US CIP 2020 taxonomy (public domain, data/cip/CIPCode2020.csv).
// Each major gets a friendly group and the id of one of our skill fields (see skills-by-field.ts).
// Run: node --import tsx scripts/build-majors.mts
import { readFileSync, writeFileSync } from "node:fs";
import { parseCsv } from "./esco-csv.mts";

type G = { group: string; field: string | null };

// CIP 2-digit family -> group label and skill field. Families not listed are skipped.
const FAMILY: Record<string, G> = {
  "01": { group: "Agriculture & food science", field: "science" },
  "03": { group: "Environment & natural resources", field: "science" },
  "04": { group: "Architecture & planning", field: "construction" },
  "05": { group: "Area, cultural & gender studies", field: "social" },
  "09": { group: "Communication & journalism", field: "media" },
  "10": { group: "Media & communications technology", field: "media" },
  "11": { group: "Computing & information sciences", field: "cs" },
  "12": { group: "Culinary & personal services", field: "hospitality" },
  "13": { group: "Education & teaching", field: "education" },
  "14": { group: "Engineering", field: "engineering" },
  "15": { group: "Engineering technology", field: "engineering" },
  "16": { group: "Languages & linguistics", field: "media" },
  "19": { group: "Family & consumer sciences", field: "social" },
  "22": { group: "Law & legal studies", field: "law" },
  "23": { group: "English & literature", field: "media" },
  "24": { group: "Liberal arts & general studies", field: null },
  "25": { group: "Library science", field: "business" },
  "26": { group: "Biology & biomedical sciences", field: "science" },
  "27": { group: "Mathematics & statistics", field: "science" },
  "31": { group: "Sport, recreation & fitness", field: "hospitality" },
  "38": { group: "Philosophy & religion", field: "social" },
  "40": { group: "Physical sciences", field: "science" },
  "41": { group: "Science technology", field: "science" },
  "42": { group: "Psychology", field: "social" },
  "43": { group: "Security & law enforcement", field: "law" },
  "44": { group: "Public administration & social service", field: "law" },
  "45": { group: "Social sciences", field: "social" },
  "46": { group: "Construction trades", field: "construction" },
  "47": { group: "Mechanics & repair", field: "trades" },
  "48": { group: "Precision production & manufacturing", field: "trades" },
  "49": { group: "Transportation & logistics", field: "logistics" },
  "50": { group: "Visual & performing arts", field: "design" },
  "51": { group: "Health professions", field: "health" },
  "52": { group: "Business & management", field: "business" },
  "54": { group: "History", field: "social" },
};

// Series-level overrides (CIP 4-digit code -> skill field).
const SERIES: Record<string, string> = {
  "45.06": "finance", // Economics
  "52.03": "finance", // Accounting
  "52.04": "business",
  "52.05": "business",
  "52.06": "business",
  "52.07": "business",
  "52.08": "finance", // Finance
  "52.10": "hr", // Human resources
  "52.12": "cs", // Management information systems
  "52.14": "marketing",
  "52.16": "finance", // Taxation
  "52.17": "finance", // Insurance
  "52.18": "sales",
  "52.19": "sales",
  "52.20": "construction",
  "52.21": "cs",
  "09.09": "marketing", // Public relations & advertising
  "11.10": "cs",
  "51.07": "health",
  "51.22": "health",
};

const code = (s: string) => s.replace(/^=/, "").trim();
const clean = (title: string) =>
  title
    .replace(/\.$/, "")
    .replace(/,\s*General$/i, "")
    .replace(/\s{2,}/g, " ")
    .trim();

const rows = parseCsv(readFileSync("data/cip/CIPCode2020.csv", "utf8"));
const series = rows.filter((r) => /^\d\d\.\d\d$/.test(code(r.CIPCode)));

const seen = new Set<string>();
const out: { value: string; group: string; field: string | null }[] = [];
for (const r of series) {
  const c = code(r.CIPCode);
  const fam = FAMILY[c.slice(0, 2)];
  if (!fam) continue;
  const title = clean(r.CIPTitle);
  if (/,\s*Other$/i.test(title) || /\bOther\b$/.test(title)) continue; // catch-all series
  // Long CIP titles list several variants ("Registered Nursing, Nursing Administration, ..."); keep the lead name.
  const lead = title.length > 48 && title.includes(",") ? title.slice(0, title.indexOf(",")).trim() : title;
  const value = lead.length > 56 ? lead.slice(0, 55).trimEnd() + "…" : lead;
  const key = value.toLowerCase();
  if (seen.has(key)) continue;
  seen.add(key);
  out.push({ value, group: fam.group, field: SERIES[c] ?? fam.field });
}

const q = (s: string) => JSON.stringify(s);
const body = out.map((m) => `  { value: ${q(m.value)}, group: ${q(m.group)}, field: ${q(m.field)} },`).join("\n");
writeFileSync(
  "src/lib/onboarding/majors-cip.ts",
  `// Generated by scripts/build-majors.mts from the CIP 2020 taxonomy (US Dept. of Education, public domain). Do not edit by hand.\n\nexport type CipMajor = { value: string; group: string; field: string | null };\n\nexport const cipMajors: CipMajor[] = [\n${body}\n];\n`,
);
console.log(`Wrote ${out.length} majors from ${series.length} CIP series`);
