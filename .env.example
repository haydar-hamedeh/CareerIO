# Copy to .env.local and fill in. Never commit real values.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-2

# Email (Resend). Without a key, emails are skipped and the in-app bell still works.
RESEND_API_KEY=
EMAIL_FROM=CareerIO <notifications@yourdomain.com>

# Secret for the daily job-alerts cron (Vercel sends it as a Bearer token). Any long random string.
CRON_SECRET=

# Public site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
